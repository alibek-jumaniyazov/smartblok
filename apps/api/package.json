{
  "name": "@smartblok/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "test:import": "tsx test/import/parse.golden.ts && tsx test/import/rules.golden.ts && tsx test/import/resolve.names.ts && tsx test/import/template-guard.ts && tsx test/import/workbook-reader.regression.ts && tsx test/import/financial-rules.regression.ts && tsx test/import/advance-reservations.regression.ts && tsx test/import/resolved-names.regression.ts && tsx test/import/smartblok-2026-09-29.regression.ts",
    "test:import:e2e": "tsx test/import/xlsb.lifecycle.ts",
    "test:smartblok:e2e": "tsx test/import/smartblok.lifecycle.ts",
    "test:kpi": "tsx test/agents/agent-kpi.regression.ts",
    "test:kpi:e2e": "tsx test/agents/agent-kpi.lifecycle.ts",
    "test:export": "tsx test/export-smartblok.regression.ts && tsx test/export-dual-debt.regression.ts",
    "test:export:client:e2e": "tsx test/client-export.lifecycle.ts",
    "test:dual-debt": "tsx test/dual-debt.regression.ts",
    "test:dual-debt:e2e": "tsx test/dual-debt.lifecycle.ts",
    "test:smartblok:october": "tsx test/import/smart-blok-2026-10-02.regression.ts",
    "test:smartblok:october:e2e": "tsx test/import/smart-blok-2026-10-02.lifecycle.ts",
    "test:realtime": "tsx test/realtime-kpi.regression.ts",
    "test:dashboard:daily": "tsx test/daily-report.xlsx.regression.ts",
    "test:dashboard:daily:e2e": "tsx test/dashboard-daily-report.lifecycle.ts",
    "test:import:settings": "tsx test/import/kpi-settings.regression.ts",
    "test:import:settings:e2e": "tsx test/import/kpi-settings.lifecycle.ts",
    "test:import:review": "tsx test/import/review-context.regression.ts",
    "test:import:review:e2e": "tsx test/import/issue-resolution.lifecycle.ts",
    "start": "node dist/main.js",
    "start:prod": "prisma migrate deploy && node dist/main.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:backfill-prices": "tsx prisma/backfill-prices.ts",
    "db:backfill-allocations": "tsx prisma/backfill-allocations.ts",
    "db:backfill-pallet-reversals": "tsx prisma/backfill-pallet-reversals.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.10.5",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
